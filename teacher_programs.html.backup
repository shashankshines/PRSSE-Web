<!DOCTYPE html>
<html lang="en"> 
    <head>
        <meta charset="utf-8" />
        <meta name="viewport" content="width=device-width,initial-scale=1,shrink-to-fit=no" />
        <meta http-equiv="x-ua-compatible" content="ie=edge" />
        <title>Professor Rajendra Singh Science Exploratory</title>
        <link rel="shortcut icon" href="assets/images/logo/favourite_icon_1.svg" />
        <link rel="stylesheet" type="text/css" href="assets/css/style.css" />
        <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
         <style>
        /* Sidebar Menu */
        .sidebarmobile {
            position: fixed;
            top: 0;
            right: -250px;
            width: 250px;
            height: 100vh; /* Full height */
            background: #333;
            color: white;
            transition: 0.3s;
            padding-top: 60px;
            z-index: 1000;
            overflow-y: auto; /* Enable scrolling */
            scrollbar-width: thin; /* Firefox */
            scrollbar-color: #888 #333; /* Firefox */
        }
        
        /* Custom scrollbar for Chrome, Edge, Safari */
        .sidebarmobile::-webkit-scrollbar {
            width: 6px;
        }
        .sidebarmobile::-webkit-scrollbar-track {
            background: #333;
        }
        .sidebarmobile::-webkit-scrollbar-thumb {
            background: #888;
            border-radius: 3px;
        }
        .sidebarmobile::-webkit-scrollbar-thumb:hover {
            background: #555;
        }
        
        .sidebarmobile a {
            padding: 15px;
            text-decoration: none;
            font-size: 18px;
            color: white;
            display: block;
            transition: 0.3s;
        }
        .sidebarmobile a:hover {
            background: #575757;
        }
        .sidebarmobile.active {
            right: 0;
        }
        .menu-overlay {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.5);
            z-index: 999;
        }
        .menu-overlay.active {
            display: block;
        }
        .mobilemenu-btn {
            font-size: 30px;
            cursor: pointer;
            color: black;
            background: none;
            border: none;
            float: right;
        }
        
         /* Dropdown Styling for Mobile */
        .dropdownmobile-toggle::after {
            display: none; /* Remove Bootstrap caret */
        }

        .dropdownmobile-menu {
            display: none; /* Hide by default */
            background: #444;
            padding-left: 15px;
        }

        .dropdownmobile-menu a {
            padding: 10px;
        }

        .dropdownmobile.open > .dropdownmobile-menu {
            display: block; /* Show when parent has class 'open' */
        }
        
        /* Styles for dropdown arrow */
        .dropdownmobile-toggle::after {
            content: " ▼";  /* Unicode down arrow */
            font-size: 12px;
            color: white;
            margin-left: 5px;
            transition: transform 0.3s ease;
        }
        
        /* Rotate arrow when dropdown is open */
        .dropdownmobile.open > .dropdownmobile-toggle::after {
            transform: rotate(180deg);
        }
        
          /* Style the dropdown arrow */
        .dropdownmobilearrow-icon {
            display: inline-block;
            margin-left: 5px;
            margin-bottom: 3px;
            border: solid white;
            border-width: 0 2px 2px 0;
            padding: 4px;
            transform: rotate(45deg);
            transition: transform 0.3s ease;
        }
        
        /* Rotate arrow when dropdown is open */
        .dropdownmobile.open .dropdownmobilearrow-icon {
            transform: rotate(225deg);
        }
        
        .dropdownmobile-menu {
            list-style: none; /* Removes default bullets */
            padding: 0; /* Remove default padding */
            margin: 0; /* Remove default margin */
        }
        
        /* Ensure dropdown menu items align properly */
        .dropdownmobile-menu li {
            padding: 5px 15px; /* Add spacing to dropdown items */
        }

        /* Hide sidebar for larger screens */
        @media screen and (min-width: 992px) {
            .sidebarmobile, .mobilemenu-btn {
                display: none;
            }
            
            .site_logo img{
              width: 330px;
            }
        }
        @media screen and (max-width:425px) {
            .site_logo img{
                width: 280px;
            }
        }
        @media screen and (max-width: 991px) {
            .container, .hero_banner.style_1 .container, .site_header .container {
                 margin-top: 0px !important; 
            }
        }
        .section-title {
      font-size: 2.5rem;
      font-weight: bold;
      margin-bottom: 20px;
      color: #2c3e50;
      position: relative;
    }

    .section-title::after {
      content: '';
      width: 70px;
      height: 4px;
      background-color: #0d6efd;
      position: absolute;
      bottom: -10px;
      left: 0;
    }

    .section-subtitle {
      font-size: 1.75rem;
      color: #0d6efd;
      margin-top: 20px;
      margin-bottom: 20px;
    }
    .card .card-body:hover {
      transform: translateY(-5px);
      box-shadow: 0 12px 25px rgba(0, 0, 0, 0.15);
    }
    .card .card-body .card-title  {
      font-weight: 600;
      color: #2c3e50 !important;
    }

    .outcomes-list li,
    .events-list li {
      margin-bottom: 10px;
      padding-left: 1.5rem;
      position: relative;
    }

    .outcomes-list li::before,
    .events-list li::before {
      content: "✔";
      position: absolute;
      left: 0;
      color: #0d6efd;
      font-weight: bold;
    }

    /* ===== Photo Gallery Styles ===== */
    
    .gallery-controls {
        animation: slideDownFade 0.6s ease-out;
    }

    .gallery-description {
        font-size: 0.95rem;
        letter-spacing: 0.5px;
    }

    /* Gallery Grid Container */
    .gallery-container {
        padding: 20px 0;
        perspective: 1000px;
    }

    .gallery-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 25px;
        margin-bottom: 40px;
        animation: fadeInGrid 0.8s ease-out;
    }

    @media (max-width: 1024px) {
        .gallery-grid {
            grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
            gap: 20px;
        }
    }

    @media (max-width: 768px) {
        .gallery-grid {
            grid-template-columns: repeat(auto-fill, minmax(180px, 1fr));
            gap: 15px;
        }
    }

    @media (max-width: 480px) {
        .gallery-grid {
            grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
            gap: 12px;
        }
    }

    /* Gallery Item */
    .gallery-item {
        position: relative;
        overflow: hidden;
        border-radius: 12px;
        box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        cursor: pointer;
        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        aspect-ratio: 1;
        background: linear-gradient(135deg, #f5f7fa 0%, #e9ecef 100%);
        animation: galleryItemFadeIn 0.6s ease-out forwards;
    }

    .gallery-item:nth-child(1) { animation-delay: 0.05s; }
    .gallery-item:nth-child(2) { animation-delay: 0.1s; }
    .gallery-item:nth-child(3) { animation-delay: 0.15s; }
    .gallery-item:nth-child(4) { animation-delay: 0.2s; }
    .gallery-item:nth-child(5) { animation-delay: 0.25s; }
    .gallery-item:nth-child(6) { animation-delay: 0.3s; }
    .gallery-item:nth-child(7) { animation-delay: 0.35s; }
    .gallery-item:nth-child(8) { animation-delay: 0.4s; }
    .gallery-item:nth-child(9) { animation-delay: 0.45s; }
    .gallery-item:nth-child(10) { animation-delay: 0.5s; }
    .gallery-item:nth-child(11) { animation-delay: 0.55s; }
    .gallery-item:nth-child(12) { animation-delay: 0.6s; }
    .gallery-item:nth-child(13) { animation-delay: 0.65s; }
    .gallery-item:nth-child(14) { animation-delay: 0.7s; }
    .gallery-item:nth-child(15) { animation-delay: 0.75s; }
    .gallery-item:nth-child(16) { animation-delay: 0.8s; }

    .gallery-item:hover {
        transform: translateY(-10px) scale(1.02);
        box-shadow: 0 12px 30px rgba(0, 0, 0, 0.25);
    }

    .gallery-item:active {
        transform: scale(0.98);
    }

    /* Gallery Image */
    .gallery-img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
        transition: transform 0.5s ease-out, filter 0.5s ease-out;
    }

    .gallery-item:hover .gallery-img {
        transform: scale(1.12) rotate(0deg);
        filter: brightness(0.85) saturate(1.2);
    }

    /* Gallery Overlay */
    .gallery-overlay {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(13, 110, 253, 0.85);
        display: flex;
        align-items: center;
        justify-content: center;
        opacity: 0;
        transition: opacity 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
        backdrop-filter: blur(4px);
    }

    .gallery-item:hover .gallery-overlay {
        opacity: 1;
    }

    .gallery-content {
        text-align: center;
        color: white;
        font-size: 2.5rem;
        transform: scale(0.5);
        opacity: 0;
        transition: all 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .gallery-item:hover .gallery-content {
        transform: scale(1);
        opacity: 1;
    }

    /* ===== Lightbox Modal ===== */
    
    .lightbox-modal {
        display: none;
        position: fixed;
        z-index: 2000;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        animation: fadeIn 0.3s ease-out;
    }

    .lightbox-modal.active {
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .lightbox-background {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 100%;
        background: rgba(0, 0, 0, 0.95);
        backdrop-filter: blur(5px);
        z-index: 1;
        animation: fadeIn 0.3s ease-out;
    }

    .lightbox-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 100%;
        max-width: 90vw;
        height: 90vh;
        animation: zoomIn 0.4s cubic-bezier(0.34, 1.56, 0.64, 1);
    }

    .lightbox-image-container {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        overflow: hidden;
        border-radius: 8px;
    }

    .lightbox-image {
        max-width: 100%;
        max-height: 100%;
        object-fit: contain;
        animation: imageSlideIn 0.4s ease-out;
    }

    /* Lightbox Navigation Buttons */
    .lightbox-close,
    .lightbox-prev,
    .lightbox-next {
        position: absolute;
        background: rgba(255, 255, 255, 0.1);
        color: white;
        border: 2px solid rgba(255, 255, 255, 0.3);
        font-size: 2rem;
        padding: 15px 20px;
        cursor: pointer;
        border-radius: 8px;
        transition: all 0.3s ease;
        z-index: 3;
        display: flex;
        align-items: center;
        justify-content: center;
        width: 50px;
        height: 50px;
    }

    .lightbox-close {
        top: 20px;
        right: 20px;
        font-size: 2.5rem;
        width: auto;
        height: auto;
        padding: 10px 18px;
    }

    .lightbox-prev,
    .lightbox-next {
        top: 50%;
        transform: translateY(-50%);
        font-size: 1.5rem;
    }

    .lightbox-prev {
        left: 20px;
    }

    .lightbox-next {
        right: 20px;
    }

    .lightbox-close:hover,
    .lightbox-prev:hover,
    .lightbox-next:hover {
        background: rgba(255, 255, 255, 0.25);
        border-color: rgba(255, 255, 255, 0.6);
        transform: scale(1.1);
        box-shadow: 0 0 20px rgba(255, 255, 255, 0.2);
    }

    .lightbox-prev:hover,
    .lightbox-next:hover {
        transform: translateY(-50%) scale(1.1);
    }

    .lightbox-close:active,
    .lightbox-prev:active,
    .lightbox-next:active {
        transform: scale(0.95);
    }

    /* Lightbox Info */
    .lightbox-info {
        position: absolute;
        bottom: 20px;
        left: 50%;
        transform: translateX(-50%);
        z-index: 3;
        animation: slideUpFade 0.4s ease-out 0.2s both;
    }

    .lightbox-counter {
        background: rgba(255, 255, 255, 0.15);
        color: white;
        padding: 8px 16px;
        border-radius: 20px;
        font-size: 0.95rem;
        backdrop-filter: blur(10px);
        border: 1px solid rgba(255, 255, 255, 0.2);
        letter-spacing: 0.5px;
    }

    /* Responsive Lightbox */
    @media (max-width: 768px) {
        .lightbox-content {
            max-width: 95vw;
            height: auto;
        }

        .lightbox-close,
        .lightbox-prev,
        .lightbox-next {
            width: 40px;
            height: 40px;
            font-size: 1.3rem;
        }

        .lightbox-prev {
            left: 10px;
        }

        .lightbox-next {
            right: 10px;
        }

        .lightbox-close {
            top: 10px;
            right: 10px;
        }
    }

    @media (max-width: 480px) {
        .lightbox-close,
        .lightbox-prev,
        .lightbox-next {
            width: 35px;
            height: 35px;
            font-size: 1.1rem;
            padding: 10px 15px;
        }

        .lightbox-close {
            padding: 8px 12px;
        }

        .lightbox-content {
            max-width: 98vw;
        }
    }

    /* ===== Animations ===== */
    
    @keyframes fadeIn {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    @keyframes zoomIn {
        from {
            transform: scale(0.9);
            opacity: 0;
        }
        to {
            transform: scale(1);
            opacity: 1;
        }
    }

    @keyframes imageSlideIn {
        from {
            opacity: 0;
            transform: scale(0.95);
        }
        to {
            opacity: 1;
            transform: scale(1);
        }
    }

    @keyframes slideDownFade {
        from {
            opacity: 0;
            transform: translateY(-20px);
        }
        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @keyframes slideUpFade {
        from {
            opacity: 0;
            transform: translateX(-50%) translateY(20px);
        }
        to {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }
    }

    @keyframes fadeInGrid {
        from {
            opacity: 0;
        }
        to {
            opacity: 1;
        }
    }

    @keyframes galleryItemFadeIn {
        from {
            opacity: 0;
            transform: translateY(20px) scale(0.95);
        }
        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }

    /* Accessibility Improvements */
    .gallery-item:focus-visible {
        outline: 3px solid #0d6efd;
        outline-offset: 2px;
    }

    .lightbox-close:focus-visible,
    .lightbox-prev:focus-visible,
    .lightbox-next:focus-visible {
        outline: 3px solid #0d6efd;
        outline-offset: 2px;
    }

    /* Prefers Reduced Motion */
    @media (prefers-reduced-motion: reduce) {
        .gallery-item,
        .gallery-img,
        .gallery-overlay,
        .gallery-content,
        .lightbox-modal,
        .lightbox-content,
        .lightbox-image,
        .lightbox-close,
        .lightbox-prev,
        .lightbox-next,
        .gallery-controls {
            animation: none !important;
            transition: none !important;
        }

        .gallery-item:hover {
            transform: none;
        }

        .gallery-item:hover .gallery-img {
            transform: none;
        }

        .gallery-item:hover .gallery-overlay {
            opacity: 0.7;
        }

        .gallery-item:hover .gallery-content {
            opacity: 1;
            transform: none;
        }
    }

    </style>
    </head>
