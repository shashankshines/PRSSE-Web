            <section class="program-overview">
                <div class="container">
                    <h2 class="mb-3 text-left section-title">Teacher Program Overview</h2>
                    <p class="text-left">Welcome to the Teacher's Induction Program webpage! Our initiative focuses on enhancing the skills and methodologies of educators in the science domain, ensuring they are well-equipped to foster engaging and effective learning environments.</p>
                     <p class="text-left" style="font-weight: bold;">
                        Program Highlights </p>
                         <h5 >Total Programs Arranged: 7</h5>
                         <h5 >Total Teachers Inducted: 151</h5>
                   
                     <p class="text-left">
                        Our induction programs are designed to strengthen classroom practices through hands-on, activity-based learning. Each session is tailored to provide teachers with innovative pedagogical strategies and resources, promoting inquiry-based learning aligned with the National Education Policy (NEP).

                        </p>
                </div>
            </section>
        
            <!-- Photo Gallery Section -->
            <section class="programs py-5 bg-light" itemscope itemtype="https://schema.org/ImageGallery">
                <div class="container">
                    <h2 class="mb-4 text-center section-subtitle" itemprop="name">Teachers Induction Reports - Gallery</h2>
                    
                    <!-- Gallery Filter/Controls -->
                    <div class="gallery-controls mb-4">
                        <div class="row">
                            <div class="col-12 text-center">
                                <p class="text-muted gallery-description">Click on images to enlarge • Press ESC to close • Use arrow keys to navigate</p>
                            </div>
                        </div>
                    </div>

                    <!-- Masonry Gallery Grid -->
                    <div class="gallery-container">
                        <div class="gallery-grid">
                            <!-- Gallery Items -->
                            <div class="gallery-item" data-index="0" itemprop="image" itemscope itemtype="https://schema.org/ImageObject">
                                <img src="assets/images/teachers/teachers_program.JPG" alt="Teacher Program Activity - Prof. Rajendra Singh Science Exploratory" loading="lazy" decoding="async" itemprop="url" class="gallery-img" />
                                <div class="gallery-overlay">
                                    <div class="gallery-content">
                                        <i class="fas fa-search-plus"></i>
                                    </div>
